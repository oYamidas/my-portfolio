---
import { business } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>&copy; {year} {business.name}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer p {
    margin: 0;
    font-size: 0.85rem;
  }
</style>
